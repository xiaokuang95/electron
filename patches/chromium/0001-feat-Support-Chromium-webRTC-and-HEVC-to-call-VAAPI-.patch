+void H265VaapiVideoEncoderDelegate::UpdateVPS() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  memset(&current_vps_, 0, sizeof(H265VPS));
+
+  H265VPS* vps = &current_vps_ ;
+
+  vps->vps_video_parameter_set_id = 0;
+  vps->vps_base_layer_internal_flag = true;
+  vps->vps_base_layer_available_flag = true;
+  vps->vps_max_layers_minus1 = 0;
+  vps->vps_max_sub_layers_minus1 = 0;
+  vps->vps_temporal_id_nesting_flag = true;
+
+  vps->profile_tier_level.general_profile_idc = H265ProfileTierLevel::kProfileIdcMain;
+  vps->profile_tier_level.general_level_idc = 4 * 30 ;
+  vps->profile_tier_level.general_profile_compatibility_flags = 0 ;
+  vps->profile_tier_level.general_profile_compatibility_flags |= 1 << 30;  // general_profile_compatibility_flags[1]=1
+  vps->profile_tier_level.general_profile_compatibility_flags |= 1 << 29;  // general_profile_compatibility_flags[2]=1
+  vps->profile_tier_level.general_progressive_source_flag = true;
+  vps->profile_tier_level.general_interlaced_source_flag = false;
+  vps->profile_tier_level.general_non_packed_constraint_flag = false;
+  vps->profile_tier_level.general_frame_only_constraint_flag = true;
+  vps->profile_tier_level.general_one_picture_only_constraint_flag = false;
+
+  for( int i=0 ; i<kMaxSubLayers ; i++ ) {
+    vps->vps_max_dec_pic_buffering_minus1[i] = kIPPeriod != 0 ? kIPPeriod : 1;
+    vps->vps_max_num_reorder_pics[i] = 0 ;
+    vps->vps_max_latency_increase_plus1[i] = 0 ;
+  }
+
+  vps->vps_max_layer_id = 0;
+  vps->vps_num_layer_sets_minus1 = 0;
+
+  vps->aux_alpha_layer_id = 0;
+
+  if (submit_packed_headers_)
+    GeneratePackedVPS();
+  encoding_parameters_changed_ = true;
+}
