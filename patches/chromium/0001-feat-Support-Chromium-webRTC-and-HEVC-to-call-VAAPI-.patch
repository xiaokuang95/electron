+void H265VaapiVideoEncoderDelegate::UpdateSPS() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  memset(&current_sps_, 0, sizeof(H265SPS));
+
+  H265SPS* sps = &current_sps_ ;
+  sps->sps_video_parameter_set_id = current_vps_.vps_video_parameter_set_id ;
+  sps->sps_max_sub_layers_minus1 = 0;
+  sps->sps_temporal_id_nesting_flag = 1;
+  sps->profile_tier_level.general_profile_idc = H265ProfileTierLevel::kProfileIdcMain;
+  sps->profile_tier_level.general_level_idc = 4 * 30 ;
+  sps->profile_tier_level.general_profile_compatibility_flags = 0 ;
+  sps->profile_tier_level.general_profile_compatibility_flags |= 1 << 30;  // general_profile_compatibility_flags[1]=1
+  sps->profile_tier_level.general_profile_compatibility_flags |= 1 << 29;  // general_profile_compatibility_flags[2]=1
+  sps->profile_tier_level.general_progressive_source_flag = true;
+  sps->profile_tier_level.general_interlaced_source_flag = false;
+  sps->profile_tier_level.general_non_packed_constraint_flag = false;
+  sps->profile_tier_level.general_frame_only_constraint_flag = true;
+  sps->profile_tier_level.general_one_picture_only_constraint_flag = false;
+  sps->sps_seq_parameter_set_id = 0;
+  sps->chroma_format_idc = kChromaFormatIDC;
+  sps->separate_colour_plane_flag = 0;
+  sps->pic_width_in_luma_samples = coded_size_.width();
+  sps->pic_height_in_luma_samples = coded_size_.height();
+  if (visible_size_ != coded_size_) {
+    sps->conf_win_left_offset = 0;
+    sps->conf_win_top_offset = 0;
+    switch (sps->chroma_format_idc) {
+    case 0:
+    case 3:  // 4:4:4 format
+        sps->conf_win_right_offset = (coded_size_.width() - visible_size_.width());
+        sps->conf_win_bottom_offset = (coded_size_.height() - visible_size_.height());
+        break;
+
+    case 2:  // 4:2:2 format
+        sps->conf_win_right_offset = (coded_size_.width() - visible_size_.width()) >> 1;
+        sps->conf_win_bottom_offset = (coded_size_.height() - visible_size_.height());
+        break;
+
+    case 1:
+    default: // 4:2:0 format
+        sps->conf_win_right_offset = (coded_size_.width() - visible_size_.width()) >> 1;
+        sps->conf_win_bottom_offset = (coded_size_.height() - visible_size_.height()) >> 1;
+        break;
+    }
+  }
+  int bit_depth = 8 ;
+  sps->bit_depth_luma_minus8 = bit_depth - 8;
+  sps->bit_depth_chroma_minus8 = bit_depth - 8;
+#define MAX(a, b) ((a)>(b)?(a):(b))
+  sps->log2_max_pic_order_cnt_lsb_minus4 = 8;
+#undef MAX
+  for( int i=0 ; i<kMaxSubLayers ; i++ ) {
+    sps->sps_max_dec_pic_buffering_minus1[i] = kIPPeriod != 0 ? kIPPeriod : 1;
+    sps->sps_max_num_reorder_pics[i] = 0 ;
+    sps->sps_max_latency_increase_plus1[i] = 0 ;
+  }
+  sps->log2_min_luma_coding_block_size_minus3 = block_sizes_.log2_min_luma_coding_block_size_minus3;
+  sps->log2_diff_max_min_luma_coding_block_size = block_sizes_.log2_max_coding_tree_block_size_minus3 - block_sizes_.log2_min_luma_coding_block_size_minus3 ;
+  sps->log2_min_luma_transform_block_size_minus2 = block_sizes_.log2_min_luma_transform_block_size_minus2;
+  sps->log2_diff_max_min_luma_transform_block_size = block_sizes_.log2_max_luma_transform_block_size_minus2 - block_sizes_.log2_min_luma_transform_block_size_minus2 ;
+  sps->max_transform_hierarchy_depth_inter = block_sizes_.max_max_transform_hierarchy_depth_inter ;
+  sps->max_transform_hierarchy_depth_intra = block_sizes_.max_max_transform_hierarchy_depth_intra ;
+  sps->scaling_list_enabled_flag = 0;
+  sps->sps_scaling_list_data_present_flag = 0;
+  // H265ScalingListData scaling_list_data;
+  sps->amp_enabled_flag = !!features_.amp;
+  sps->sample_adaptive_offset_enabled_flag = !!features_.sao;
+  sps->pcm_enabled_flag = !!features_.pcm;
+  // int pcm_sample_bit_depth_luma_minus1;
+  // int pcm_sample_bit_depth_chroma_minus1;
+  // int log2_min_pcm_luma_coding_block_size_minus3;
+  // int log2_diff_max_min_pcm_luma_coding_block_size;
+  // bool pcm_loop_filter_disabled_flag;
+
+  sps->num_short_term_ref_pic_sets = kIPPeriod;
+  uint32_t strp_index;
+  int i ;
+#define MIN(a, b) ((a)>(b)?(b):(a))
+  for (strp_index = 0; strp_index < MIN(kIPPeriod, kMaxShortTermRefPicSets); strp_index++) {
+    H265StRefPicSet* strps = &(sps->st_ref_pic_set[strp_index]);
+    strps->num_negative_pics = numActiveRefP;
+    strps->num_positive_pics = (strp_index == 0 ? 0 : kIPPeriod > 1 ? 1 : 0);
+    if (strp_index == 0) {
+        for (i = 0; i < strps->num_negative_pics; i++) {
+            strps->delta_poc_s0[i] = kIPPeriod;
+            strps->used_by_curr_pic_s0[i] = 1;
+        }
+    } else {
+        for (i = 0; i < strps->num_negative_pics; i++) {
+            strps->delta_poc_s0[i] = (i == 0) ? strp_index : kIPPeriod;
+            strps->used_by_curr_pic_s0[i] = 1;
+        }
+        for (i = 0; i < strps->num_positive_pics; i++) {
+            strps->delta_poc_s1[i] = kIPPeriod - strp_index;
+            strps->used_by_curr_pic_s1[i] = 1;
+        }
+
+    }
+  }
+#undef MIN
+  sps->long_term_ref_pics_present_flag = 0;
+  // int num_long_term_ref_pics_sps;
+  // int lt_ref_pic_poc_lsb_sps[kMaxLongTermRefPicSets];
+  // bool used_by_curr_pic_lt_sps_flag[kMaxLongTermRefPicSets];
+  sps->sps_temporal_mvp_enabled_flag = !!features_.temporal_mvp;
+  sps->strong_intra_smoothing_enabled_flag = 0;
+  // H265VUIParameters vui_parameters;
+
+
+  if (submit_packed_headers_)
+    GeneratePackedSPS();
+  encoding_parameters_changed_ = true;
+}
