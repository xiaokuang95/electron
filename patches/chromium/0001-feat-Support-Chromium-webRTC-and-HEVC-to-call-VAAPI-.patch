+void H265VaapiVideoEncoderDelegate::UpdatePPS() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  memset(&current_pps_, 0, sizeof(H265PPS));
+
+  H265PPS* pps = &current_pps_ ;
+  pps->pps_pic_parameter_set_id = current_vps_.vps_video_parameter_set_id ;
+  pps->pps_seq_parameter_set_id = current_sps_.sps_seq_parameter_set_id ;
+  pps->dependent_slice_segments_enabled_flag = 0;
+  pps->output_flag_present_flag = 0;
+  pps->num_extra_slice_header_bits = 0;
+  pps->sign_data_hiding_enabled_flag = 0;
+  pps->cabac_init_present_flag = 0;
+  pps->num_ref_idx_l0_default_active_minus1 = 0;
+  pps->num_ref_idx_l1_default_active_minus1 = 0;
+  pps->init_qp_minus26 = kDefaultQP - 26;
+  pps->constrained_intra_pred_flag = 0;
+  pps->transform_skip_enabled_flag = !!features_.transform_skip;
+  pps->cu_qp_delta_enabled_flag = kIsNotCQP ? !!features_.cu_qp_delta : 0;
+  if (pps->cu_qp_delta_enabled_flag)
+      pps->diff_cu_qp_delta_depth = current_sps_.log2_diff_max_min_luma_coding_block_size;
+  pps->pps_cb_qp_offset = 0;
+  pps->pps_cr_qp_offset = 0;
+  pps->pps_slice_chroma_qp_offsets_present_flag = 0;
+  pps->weighted_pred_flag = 0;
+  pps->weighted_bipred_flag = 0;
+  pps->transquant_bypass_enabled_flag = 0;
+  pps->tiles_enabled_flag = 0;
+  pps->entropy_coding_sync_enabled_flag = 0;
+  // int num_tile_columns_minus1;
+  // int num_tile_rows_minus1;
+  // bool uniform_spacing_flag;
+  // int column_width_minus1[kMaxNumTileColumnWidth];
+  // int row_height_minus1[kMaxNumTileRowHeight];
+  // bool loop_filter_across_tiles_enabled_flag;
+  pps->pps_loop_filter_across_slices_enabled_flag = 1;
+  pps->deblocking_filter_control_present_flag = 0;
+  pps->deblocking_filter_override_enabled_flag = 0;
+  pps->pps_deblocking_filter_disabled_flag = 0;
+  pps->pps_beta_offset_div2 = 2;
+  pps->pps_tc_offset_div2 = 0;
+  pps->pps_scaling_list_data_present_flag = 0;
+  // H265ScalingListData scaling_list_data;
+  pps->lists_modification_present_flag = 0;
+  pps->log2_parallel_merge_level_minus2 = 0;
+  pps->slice_segment_header_extension_present_flag = 0;
+
+
+  if (submit_packed_headers_)
+    GeneratePackedPPS();
+  encoding_parameters_changed_ = true;
+}
+
+void H265VaapiVideoEncoderDelegate::GeneratePackedVPS() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(submit_packed_headers_);
+  DCHECK(packed_vps_);
+
+
+  packed_vps_->Reset();
+
+  packed_vps_->BeginNALU(H265NALU::VPS_NUT, 3);
+
+  packed_vps_->AppendBits(4, current_vps_.vps_video_parameter_set_id);
+  packed_vps_->AppendBits(2, 3);
+  packed_vps_->AppendBits(6, 0);
+  packed_vps_->AppendBits(3, current_vps_.vps_max_sub_layers_minus1);
+  packed_vps_->AppendBits(1, current_vps_.vps_temporal_id_nesting_flag ? 1 : 0);
+  packed_vps_->AppendBits(16, 0xFFFF);
+
+  H265ProfileTierLevel profile_tier_level = current_vps_.profile_tier_level;
+    packed_vps_->AppendBits(2, 0); //general_profile_space
+    packed_vps_->AppendBits(1, 0); //general_tier_flag
+    packed_vps_->AppendBits(5, profile_tier_level.general_profile_idc);
+    packed_vps_->AppendBits(32,profile_tier_level.general_profile_compatibility_flags);
+    packed_vps_->AppendBits(1, profile_tier_level.general_progressive_source_flag);
+    packed_vps_->AppendBits(1, profile_tier_level.general_interlaced_source_flag);
+    packed_vps_->AppendBits(1, profile_tier_level.general_non_packed_constraint_flag);
+    packed_vps_->AppendBits(1, profile_tier_level.general_frame_only_constraint_flag);
+    packed_vps_->AppendBits(16, 0);
+    packed_vps_->AppendBits(16, 0);
+    packed_vps_->AppendBits(12, 0);
+    packed_vps_->AppendBits(8, profile_tier_level.general_level_idc);
+
+  int vps_sub_layer_ordering_info_present_flag = 0 ;
+  packed_vps_->AppendBits(1, vps_sub_layer_ordering_info_present_flag); //vps_sub_layer_ordering_info_present_flag
+    for (int i = (vps_sub_layer_ordering_info_present_flag ? 0 : current_vps_.vps_max_sub_layers_minus1); i <= current_vps_.vps_max_sub_layers_minus1; i++) {
+        // NOTE: In teddi and mv_encoder, the setting is max_dec_pic_buffering.
+        // here just follow the spec 7.3.2.1
+        packed_vps_->AppendUE(current_vps_.vps_max_dec_pic_buffering_minus1[i]);
+        packed_vps_->AppendUE(current_vps_.vps_max_num_reorder_pics[i]);
+        packed_vps_->AppendUE(current_vps_.vps_max_latency_increase_plus1[i]);
+    }
+
+  packed_vps_->AppendBits(6, 0); //vps_max_nuh_reserved_zero_layer_id
+  packed_vps_->AppendUE(0); //vps_num_op_sets_minus1
+  packed_vps_->AppendBits(1, 0); //vps_timing_info_present_flag
+  packed_vps_->AppendBits(1, 0); // no extension flag
+
+  packed_vps_->FinishNALU();
+
+
+  // base::span<const uint8_t> magic(packed_vps_->data(), packed_vps_->BytesInBuffer());
+  // base::FilePath log_file_path(FILE_PATH_LITERAL("/tmp/testChrome.h265.VPS")) ;
+  //   base::WriteFile(log_file_path,magic) ;
+}
+
+void H265VaapiVideoEncoderDelegate::GeneratePackedSPS() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(submit_packed_headers_);
+  DCHECK(packed_sps_);
+
+  packed_sps_->Reset();
+
+  packed_sps_->BeginNALU(H265NALU::SPS_NUT, 3);
+
+  packed_sps_->AppendBits(4, current_sps_.sps_video_parameter_set_id);
+  packed_sps_->AppendBits(3, current_sps_.sps_max_sub_layers_minus1);
+  packed_sps_->AppendBits(1, current_sps_.sps_temporal_id_nesting_flag);
+
+  H265ProfileTierLevel profile_tier_level = current_sps_.profile_tier_level;
+    packed_sps_->AppendBits(2, 0); //general_profile_space
+    packed_sps_->AppendBits(1, 0); //general_tier_flag
+    packed_sps_->AppendBits(5, profile_tier_level.general_profile_idc);
+    packed_sps_->AppendBits(32,profile_tier_level.general_profile_compatibility_flags);
+    packed_sps_->AppendBits(1, profile_tier_level.general_progressive_source_flag);
+    packed_sps_->AppendBits(1, profile_tier_level.general_interlaced_source_flag);
+    packed_sps_->AppendBits(1, profile_tier_level.general_non_packed_constraint_flag);
+    packed_sps_->AppendBits(1, profile_tier_level.general_frame_only_constraint_flag);
+    packed_sps_->AppendBits(16, 0);
+    packed_sps_->AppendBits(16, 0);
+    packed_sps_->AppendBits(12, 0);
+    packed_sps_->AppendBits(8, profile_tier_level.general_level_idc);
+
+  packed_sps_->AppendUE(current_sps_.sps_seq_parameter_set_id);
+  packed_sps_->AppendUE(current_sps_.chroma_format_idc);
+
+  if (current_sps_.chroma_format_idc == 3) {
+      packed_sps_->AppendBits(1, current_sps_.separate_colour_plane_flag);
+
+  }
+  packed_sps_->AppendUE(current_sps_.pic_width_in_luma_samples);
+  packed_sps_->AppendUE(current_sps_.pic_height_in_luma_samples);
+
+  int conformance_window_flag = (visible_size_ != coded_size_);
+  packed_sps_->AppendBits(1, conformance_window_flag);
+  if (conformance_window_flag) {
+      packed_sps_->AppendUE(current_sps_.conf_win_left_offset);
+      packed_sps_->AppendUE(current_sps_.conf_win_right_offset);
+      packed_sps_->AppendUE(current_sps_.conf_win_top_offset);
+      packed_sps_->AppendUE(current_sps_.conf_win_bottom_offset);
+  }
+  packed_sps_->AppendUE(current_sps_.bit_depth_luma_minus8);
+  packed_sps_->AppendUE(current_sps_.bit_depth_chroma_minus8);
+  packed_sps_->AppendUE(current_sps_.log2_max_pic_order_cnt_lsb_minus4);
+
+  int sps_sub_layer_ordering_info_present_flag = 0 ;
+  packed_sps_->AppendBits(1, sps_sub_layer_ordering_info_present_flag);
+
+  for (int i = (sps_sub_layer_ordering_info_present_flag ? 0 : current_sps_.sps_max_sub_layers_minus1); i <= current_sps_.sps_max_sub_layers_minus1; i++) {
+      // NOTE: In teddi and mv_encoder, the setting is max_dec_pic_buffering.
+      // here just follow the spec 7.3.2.2
+      packed_sps_->AppendUE(current_sps_.sps_max_dec_pic_buffering_minus1[i]);
+      packed_sps_->AppendUE(current_sps_.sps_max_num_reorder_pics[i]);
+      packed_sps_->AppendUE(current_sps_.sps_max_latency_increase_plus1[i]);
+  }
+
+  packed_sps_->AppendUE(current_sps_.log2_min_luma_coding_block_size_minus3);
+  packed_sps_->AppendUE(current_sps_.log2_diff_max_min_luma_coding_block_size);
+  packed_sps_->AppendUE(current_sps_.log2_min_luma_transform_block_size_minus2);
+  packed_sps_->AppendUE(current_sps_.log2_diff_max_min_luma_transform_block_size);
+  packed_sps_->AppendUE(current_sps_.max_transform_hierarchy_depth_inter);
+  packed_sps_->AppendUE(current_sps_.max_transform_hierarchy_depth_intra);
+
+  // scaling_list_enabled_flag is set as 0 in fill_sps_header() for now
+  packed_sps_->AppendBits(1, current_sps_.scaling_list_enabled_flag);
+  if (current_sps_.scaling_list_enabled_flag) {
+      packed_sps_->AppendBits(1, current_sps_.sps_scaling_list_data_present_flag);
+      if (current_sps_.sps_scaling_list_data_present_flag) {
+          //H265ScalingListData;
+      }
+  }
+
+  packed_sps_->AppendBits(1, current_sps_.amp_enabled_flag);
+  packed_sps_->AppendBits(1, current_sps_.sample_adaptive_offset_enabled_flag);
+
+  packed_sps_->AppendBits(1, current_sps_.pcm_enabled_flag);
+  if (current_sps_.pcm_enabled_flag) {
+      packed_sps_->AppendBits(4, current_sps_.pcm_sample_bit_depth_luma_minus1);
+      packed_sps_->AppendBits(4, current_sps_.pcm_sample_bit_depth_chroma_minus1);
+      packed_sps_->AppendUE(current_sps_.log2_min_pcm_luma_coding_block_size_minus3);
+      packed_sps_->AppendUE(current_sps_.log2_diff_max_min_pcm_luma_coding_block_size);
+      packed_sps_->AppendBits(1, current_sps_.pcm_loop_filter_disabled_flag);
+  }
+
+  packed_sps_->AppendUE(current_sps_.num_short_term_ref_pic_sets);
+  for (int strp_index = 0; strp_index < current_sps_.num_short_term_ref_pic_sets; strp_index++) {
+    H265StRefPicSet strps = current_sps_.st_ref_pic_set[strp_index];
+
+    if (strp_index>0) {
+        int inter_ref_pic_set_prediction_flag = 0; // inter_ref_pic_set_prediction_flag is always 0 now
+        packed_sps_->AppendBits(1, inter_ref_pic_set_prediction_flag);
+    }
+
+    // inter_ref_pic_set_prediction_flag is always 0 now
+    packed_sps_->AppendUE(strps.num_negative_pics);
+    packed_sps_->AppendUE(strps.num_positive_pics);
+
+    for (int i = 0; i < strps.num_negative_pics; i++) {
+        packed_sps_->AppendUE(strps.delta_poc_s0[i]-1);
+        packed_sps_->AppendBits(1, strps.used_by_curr_pic_s0[i]);
+    }
+    for (int i = 0; i < strps.num_positive_pics; i++) {
+        packed_sps_->AppendUE(strps.delta_poc_s1[i]-1);
+        packed_sps_->AppendBits(1, strps.used_by_curr_pic_s1[i]);
+    }
+  }
+
+  // long_term_ref_pics_present_flag is set as 0 in UpdateSPS() for now
+  packed_sps_->AppendBits(1, current_sps_.long_term_ref_pics_present_flag);
+  if (current_sps_.long_term_ref_pics_present_flag) {
+      packed_sps_->AppendUE(current_sps_.num_long_term_ref_pics_sps);
+      for (int i = 0; i < current_sps_.num_long_term_ref_pics_sps; i++) {
+          packed_sps_->AppendUE(current_sps_.lt_ref_pic_poc_lsb_sps[i]);
+          packed_sps_->AppendBits(1, current_sps_.used_by_curr_pic_lt_sps_flag[i]);
+      }
+  }
+
+  packed_sps_->AppendBits(1, current_sps_.sps_temporal_mvp_enabled_flag);
+  packed_sps_->AppendBits(1, current_sps_.strong_intra_smoothing_enabled_flag);
+
+  //HACK vui_parameters_present_flag is set as 0 in UpdateSPS() for now
+  bool vui_parameters_present_flag = false;
+  packed_sps_->AppendBits(1, vui_parameters_present_flag);
+  if( vui_parameters_present_flag ) {
+    // H265VUIParameters
+  }
+
+  packed_sps_->AppendBits(1, current_sps_.sps_extension_present_flag);
+
+
+  packed_sps_->FinishNALU();
+
+
+  // base::span<const uint8_t> magic(packed_sps_->data(), packed_sps_->BytesInBuffer());
+  // base::FilePath log_file_path(FILE_PATH_LITERAL("/tmp/testChrome.h265.SPS")) ;
+  //   base::WriteFile(log_file_path,magic) ;
+}
+
+void H265VaapiVideoEncoderDelegate::GeneratePackedPPS() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(submit_packed_headers_);
+  DCHECK(packed_pps_);
+
+  packed_pps_->Reset();
+
+  packed_pps_->BeginNALU(H265NALU::PPS_NUT, 3);
+
+
+    packed_pps_->AppendUE(current_pps_.pps_pic_parameter_set_id);
+    packed_pps_->AppendUE(current_pps_.pps_seq_parameter_set_id);
+    packed_pps_->AppendBits(1, current_pps_.dependent_slice_segments_enabled_flag);
+    packed_pps_->AppendBits(1, current_pps_.output_flag_present_flag);
+    packed_pps_->AppendBits(3, current_pps_.num_extra_slice_header_bits);
+    packed_pps_->AppendBits(1, current_pps_.sign_data_hiding_enabled_flag);
+    packed_pps_->AppendBits(1, current_pps_.cabac_init_present_flag);
+
+    packed_pps_->AppendUE(current_pps_.num_ref_idx_l0_default_active_minus1);
+    packed_pps_->AppendUE(current_pps_.num_ref_idx_l1_default_active_minus1);
+    packed_pps_->AppendSE(current_pps_.init_qp_minus26);
+
+    packed_pps_->AppendBits(1, current_pps_.constrained_intra_pred_flag);
+    packed_pps_->AppendBits(1, current_pps_.transform_skip_enabled_flag);
+
+    packed_pps_->AppendBits(1, current_pps_.cu_qp_delta_enabled_flag);
+    if (current_pps_.cu_qp_delta_enabled_flag) {
+        packed_pps_->AppendUE(current_pps_.diff_cu_qp_delta_depth);
+    }
+
+    packed_pps_->AppendSE(current_pps_.pps_cb_qp_offset);
+    packed_pps_->AppendSE(current_pps_.pps_cr_qp_offset);
+
+    packed_pps_->AppendBits(1, current_pps_.pps_slice_chroma_qp_offsets_present_flag);
+    packed_pps_->AppendBits(1, current_pps_.weighted_pred_flag);
+    packed_pps_->AppendBits(1, current_pps_.weighted_bipred_flag);
+    packed_pps_->AppendBits(1, current_pps_.transquant_bypass_enabled_flag);
+    packed_pps_->AppendBits(1, current_pps_.tiles_enabled_flag);
+    packed_pps_->AppendBits(1, current_pps_.entropy_coding_sync_enabled_flag);
+
+    if (current_pps_.tiles_enabled_flag) {
+        packed_pps_->AppendUE(current_pps_.num_tile_columns_minus1);
+        packed_pps_->AppendUE(current_pps_.num_tile_rows_minus1);
+        packed_pps_->AppendBits(1, current_pps_.uniform_spacing_flag);
+        if (!current_pps_.uniform_spacing_flag) {
+            for (int i = 0; i < current_pps_.num_tile_columns_minus1; i++) {
+                packed_pps_->AppendUE(current_pps_.column_width_minus1[i]);
+            }
+
+            for (int i = 0; i < current_pps_.num_tile_rows_minus1; i++) {
+                packed_pps_->AppendUE(current_pps_.row_height_minus1[i]);
+            }
+
+        }
+        packed_pps_->AppendBits(1, current_pps_.loop_filter_across_tiles_enabled_flag);
+    }
+
+    packed_pps_->AppendBits(1, current_pps_.pps_loop_filter_across_slices_enabled_flag);
+    packed_pps_->AppendBits(1, current_pps_.deblocking_filter_control_present_flag);
+    if (current_pps_.deblocking_filter_control_present_flag) {
+        packed_pps_->AppendBits(1, current_pps_.deblocking_filter_override_enabled_flag);
+        packed_pps_->AppendBits(1, current_pps_.pps_deblocking_filter_disabled_flag);
+        if (!current_pps_.pps_deblocking_filter_disabled_flag) {
+            packed_pps_->AppendSE(current_pps_.pps_beta_offset_div2);
+            packed_pps_->AppendSE(current_pps_.pps_tc_offset_div2);
+        }
+    }
+
+    // pps_scaling_list_data_present_flag is set as 0 in fill_pps_header() for now
+    packed_pps_->AppendBits(1, current_pps_.pps_scaling_list_data_present_flag);
+    if (current_pps_.pps_scaling_list_data_present_flag) {
+        //H265ScalingListData;
+    }
+
+    packed_pps_->AppendBits(1, current_pps_.lists_modification_present_flag);
+    packed_pps_->AppendUE(current_pps_.log2_parallel_merge_level_minus2);
+    packed_pps_->AppendBits(1, current_pps_.slice_segment_header_extension_present_flag);
+
+    packed_pps_->AppendBits(1, current_pps_.pps_extension_present_flag);
+    if (current_pps_.pps_extension_present_flag) {
+        packed_pps_->AppendBits(1, current_pps_.pps_range_extension_flag);
+        packed_pps_->AppendBits(1, current_pps_.pps_multilayer_extension_flag);
+        packed_pps_->AppendBits(1, current_pps_.pps_3d_extension_flag);
+        packed_pps_->AppendBits(5, 0); //pps_scc_extension_flag + pps_extension_4bits ?
+
+    }
+
+    if (current_pps_.pps_range_extension_flag) {
+        if (current_pps_.transform_skip_enabled_flag)
+            packed_pps_->AppendUE(current_pps_.log2_max_transform_skip_block_size_minus2);
+        packed_pps_->AppendBits(1, current_pps_.cross_component_prediction_enabled_flag);
+        packed_pps_->AppendBits(1, current_pps_.chroma_qp_offset_list_enabled_flag);
+
+        if (current_pps_.chroma_qp_offset_list_enabled_flag) {
+            packed_pps_->AppendUE(current_pps_.diff_cu_chroma_qp_offset_depth);
+            packed_pps_->AppendUE(current_pps_.chroma_qp_offset_list_len_minus1);
+            for (int i = 0; i <= current_pps_.chroma_qp_offset_list_len_minus1; i++) {
+                packed_pps_->AppendUE(current_pps_.cb_qp_offset_list[i]);
+                packed_pps_->AppendUE(current_pps_.cr_qp_offset_list[i]);
+            }
+        }
+
+        packed_pps_->AppendUE(current_pps_.log2_sao_offset_scale_luma);
+        packed_pps_->AppendUE(current_pps_.log2_sao_offset_scale_chroma);
+    }
+
+
+  packed_pps_->FinishNALU();
+
+  // base::span<const uint8_t> magic(packed_pps_->data(), packed_pps_->BytesInBuffer());
+  // base::FilePath log_file_path(FILE_PATH_LITERAL("/tmp/testChrome.h265.PPS")) ;
+  //   base::WriteFile(log_file_path,magic) ;
+}
+
+scoped_refptr<H265BitstreamBuffer>
+H265VaapiVideoEncoderDelegate::GeneratePackedSliceHeader(
+    const H265SPS& sps,
+    const H265PPS& pps,
+    const H265SliceHeader& slice_header) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+
+  auto packed_slice_header = base::MakeRefCounted<H265BitstreamBuffer>();
+
+  size_t nal_ref_idc = 0;
+  H265NALU::Type nalu_type = static_cast<H265NALU::Type>(slice_header.nal_unit_type);
+  switch( slice_header.nal_unit_type ) {
+    case H265NALU::Type::IDR_W_RADL :
+      nal_ref_idc = 3 ;
+      break ;
+    case H265NALU::Type::TRAIL_R :
+      switch( slice_header.slice_type ) {
+        case H265SliceHeader::kSliceTypeI :
+          nal_ref_idc = 2 ;
+          break ;
+        case H265SliceHeader::kSliceTypeP :
+          nal_ref_idc = 1 ;
+          break ;
+        case H265SliceHeader::kSliceTypeB :
+          nal_ref_idc = 0 ;
+          break ;
+      }
+      break ;
+  }
+
+  packed_slice_header->BeginNALU(nalu_type, nal_ref_idc);
+
+    packed_slice_header->AppendBits(1, slice_header.first_slice_segment_in_pic_flag);
+    if (slice_header.nal_unit_type >= 16 && slice_header.nal_unit_type <= 23) {
+        packed_slice_header->AppendBits(1, slice_header.no_output_of_prior_pics_flag);
+    }
+    packed_slice_header->AppendUE(slice_header.slice_pic_parameter_set_id);
+    if (!slice_header.first_slice_segment_in_pic_flag) {
+        if (slice_header.dependent_slice_segment_flag) {
+            packed_slice_header->AppendBits(1, slice_header.dependent_slice_segment_flag);
+        }
+        // untested
+        int lcu_size = 1 << (block_sizes_.log2_max_coding_tree_block_size_minus3 + 3);
+        int picture_height_in_ctus = (visible_size_.height() + lcu_size - 1) / lcu_size;
+        int picture_width_in_ctus = (visible_size_.width() + lcu_size - 1) / lcu_size;
+        packed_slice_header->AppendBits((uint8_t)(ceil(log(picture_height_in_ctus * picture_width_in_ctus) / log(2.0))),
+                                        slice_header.slice_segment_address);
+    }
+    if (!slice_header.dependent_slice_segment_flag) {
+        for (int i = 0; i < pps.num_extra_slice_header_bits; i++) {
+            int slice_reserved_undetermined_flag = 0 ; // pps.num_extra_slice_header_bits set at 0
+            packed_slice_header->AppendBits(1, slice_reserved_undetermined_flag);
+        }
+        packed_slice_header->AppendUE(slice_header.slice_type);
+        if (pps.output_flag_present_flag) {
+            packed_slice_header->AppendBits(1, slice_header.pic_output_flag);
+        }
+        if (sps.separate_colour_plane_flag == 1) {
+            packed_slice_header->AppendBits(2, slice_header.colour_plane_id);
+        }
+        if (!(slice_header.nal_unit_type == H265NALU::IDR_W_RADL || slice_header.nal_unit_type == H265NALU::IDR_N_LP)) {
+            packed_slice_header->AppendBits((sps.log2_max_pic_order_cnt_lsb_minus4 + 4), slice_header.slice_pic_order_cnt_lsb);
+            packed_slice_header->AppendBits(1, slice_header.short_term_ref_pic_set_sps_flag);
+
+            if (!slice_header.short_term_ref_pic_set_sps_flag) {
+                //HACK : unused
+            } else if (sps.num_short_term_ref_pic_sets > 1) {
+                packed_slice_header->AppendBits((uint8_t)(ceil(log(sps.num_short_term_ref_pic_sets) / log(2.0))), slice_header.short_term_ref_pic_set_idx);
+            }
+            if (sps.long_term_ref_pics_present_flag) {
+                if (sps.num_long_term_ref_pics_sps > 0) {
+                    packed_slice_header->AppendUE(slice_header.num_long_term_sps);
+                }
+                packed_slice_header->AppendUE(slice_header.num_long_term_pics);
+            }
+            if (sps.sps_temporal_mvp_enabled_flag) {
+                packed_slice_header->AppendBits(1, slice_header.slice_temporal_mvp_enabled_flag);
+            }
+        }
+
+        if (sps.sample_adaptive_offset_enabled_flag) {
+            packed_slice_header->AppendBits(1, slice_header.slice_sao_luma_flag);
+            packed_slice_header->AppendBits(1, slice_header.slice_sao_chroma_flag);
+        }
+
+        if (slice_header.slice_type != H265SliceHeader::kSliceTypeI) {
+            packed_slice_header->AppendBits(1, slice_header.num_ref_idx_active_override_flag);
+
+            if (slice_header.num_ref_idx_active_override_flag) {
+                packed_slice_header->AppendUE(slice_header.num_ref_idx_l0_active_minus1);
+                if (slice_header.slice_type == H265SliceHeader::kSliceTypeB)
+                    packed_slice_header->AppendUE(slice_header.num_ref_idx_l1_active_minus1);
+            }
+
+            if (pps.lists_modification_present_flag /*&& slice_header.num_poc_total_cur > 1*/) {
+                /* ref_pic_list_modification */
+                // HACK : unused
+            }
+
+            if (slice_header.slice_type == H265SliceHeader::kSliceTypeB) {
+                packed_slice_header->AppendBits(1, slice_header.mvd_l1_zero_flag);
+            }
+
+            if (pps.cabac_init_present_flag) {
+                packed_slice_header->AppendBits(1, slice_header.cabac_init_flag);
+            }
+
+            if (slice_header.slice_temporal_mvp_enabled_flag) {
+                int collocated_from_l0_flag = 1;
+
+                if (slice_header.slice_type == H265SliceHeader::kSliceTypeB) {
+                    collocated_from_l0_flag = slice_header.collocated_from_l0_flag;
+                    packed_slice_header->AppendBits(1, slice_header.collocated_from_l0_flag);
+                }
+
+                if (((collocated_from_l0_flag && (slice_header.num_ref_idx_l0_active_minus1 > 0)) ||
+                     (!collocated_from_l0_flag && (slice_header.num_ref_idx_l1_active_minus1 > 0)))) {
+                    packed_slice_header->AppendUE(slice_header.collocated_ref_idx);
+                }
+            }
+
+            packed_slice_header->AppendUE(slice_header.five_minus_max_num_merge_cand);
+        }
+
+        packed_slice_header->AppendSE(slice_header.slice_qp_delta);
+
+        if (pps.chroma_qp_offset_list_enabled_flag) {
+            packed_slice_header->AppendSE(pps.pps_cb_qp_offset);
+            packed_slice_header->AppendSE(pps.pps_cr_qp_offset);
+        }
+
+        int deblocking_filter_override_flag = 0 ;  // from PPS ??
+        if (pps.deblocking_filter_override_enabled_flag) {
+            packed_slice_header->AppendBits(1, deblocking_filter_override_flag);
+        }
+        if (deblocking_filter_override_flag) {
+            packed_slice_header->AppendBits(1, slice_header.slice_deblocking_filter_disabled_flag);
+
+            if (!slice_header.slice_deblocking_filter_disabled_flag) {
+                packed_slice_header->AppendSE(slice_header.slice_beta_offset_div2);
+                packed_slice_header->AppendSE(slice_header.slice_tc_offset_div2);
+            }
+        }
+
+        if (pps.pps_loop_filter_across_slices_enabled_flag &&
+            (slice_header.slice_sao_luma_flag || slice_header.slice_sao_chroma_flag ||
+             !slice_header.slice_deblocking_filter_disabled_flag)) {
+            packed_slice_header->AppendBits(1, slice_header.slice_loop_filter_across_slices_enabled_flag);
+        }
+
+    }
+
+    if ((pps.tiles_enabled_flag) || (pps.entropy_coding_sync_enabled_flag)) {
+        int num_entry_point_offsets = 0 ; // ??
+        int offset_len_minus1 = 0 ; // ??
+        packed_slice_header->AppendUE(num_entry_point_offsets);
+        if (num_entry_point_offsets > 0) {
+            packed_slice_header->AppendUE(offset_len_minus1);
+        }
+    }
+    if (pps.slice_segment_header_extension_present_flag) {
+        int slice_header_extension_length = 0;
+        packed_slice_header->AppendUE(slice_header_extension_length);
+    }
+
+
+  //packed_slice_header->Flush();
+  packed_slice_header->FinishNALU() ;
+  // base::span<const uint8_t> magic(packed_slice_header->data(), packed_slice_header->BytesInBuffer());
+  // base::FilePath log_file_path(FILE_PATH_LITERAL("/tmp/testChrome.h265.SLICEHEADER")) ;
+  //   base::WriteFile(log_file_path,magic) ;
+
+
+
+
+  return packed_slice_header;
+}
+
+bool H265VaapiVideoEncoderDelegate::SubmitFrameParameters(
+    EncodeJob& job,
+    const H265VaapiVideoEncoderDelegate::EncodeParams& encode_params,
+    const H265VPS& vps,
+    const H265SPS& sps,
+    const H265PPS& pps,
+    scoped_refptr<H265Picture> pic,
+    const base::circular_deque<scoped_refptr<H265Picture>>& ref_pic_list0) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  const Bitrate bitrate = encode_params.bitrate_allocation.GetSumBitrate();
+  uint32_t bitrate_bps = bitrate.target_bps();
+
+
+  H265SliceHeader h265slice ;
+  memset(&h265slice, 0, sizeof(H265SliceHeader));
+
+  h265slice.nal_unit_type = pic->idr ? H265NALU::Type::IDR_W_RADL : H265NALU::Type::TRAIL_R ;
+
+  h265slice.slice_segment_address = 0;
+  h265slice.first_slice_segment_in_pic_flag = ((h265slice.slice_segment_address == 0) ? 1 : 0);
+  h265slice.no_output_of_prior_pics_flag = 0;
+  h265slice.slice_pic_parameter_set_id = pps.pps_pic_parameter_set_id ;
+  h265slice.dependent_slice_segment_flag = 0;
+  h265slice.slice_type = pic->idr ? H265SliceHeader::kSliceTypeI : H265SliceHeader::kSliceTypeP;
+  h265slice.pic_output_flag = 1;
+  h265slice.colour_plane_id = 0;
+  h265slice.slice_pic_order_cnt_lsb = pic->pic_order_cnt &
+        (1 << (sps.log2_max_pic_order_cnt_lsb_minus4 + 4)) - 1;
+  h265slice.short_term_ref_pic_set_sps_flag = 1;  // Use SPS short_term_ref_pic_set
+  // H265StRefPicSet st_ref_pic_set;
+  h265slice.short_term_ref_pic_set_idx = h265slice.slice_pic_order_cnt_lsb % kIPPeriod;
+  // int num_long_term_sps;
+  // int num_long_term_pics;
+  // int poc_lsb_lt[kMaxLongTermRefPicSets];
+  // bool used_by_curr_pic_lt[kMaxLongTermRefPicSets];
+  // bool delta_poc_msb_present_flag[kMaxLongTermRefPicSets];
+  // int delta_poc_msb_cycle_lt[kMaxLongTermRefPicSets];
+  h265slice.slice_temporal_mvp_enabled_flag = sps.sps_temporal_mvp_enabled_flag;
+  h265slice.slice_sao_luma_flag = sps.sample_adaptive_offset_enabled_flag;
+  h265slice.slice_sao_chroma_flag = sps.sample_adaptive_offset_enabled_flag;
+  h265slice.num_ref_idx_active_override_flag = 0;
+  h265slice.num_ref_idx_l0_active_minus1 = pps.num_ref_idx_l0_default_active_minus1;
+  h265slice.num_ref_idx_l1_active_minus1 = pps.num_ref_idx_l1_default_active_minus1;
+  // H265RefPicListsModifications ref_pic_lists_modification;
+  h265slice.mvd_l1_zero_flag = 0;
+  h265slice.cabac_init_flag = 0;
+  h265slice.collocated_from_l0_flag = 1;
+  h265slice.collocated_ref_idx = pps.num_ref_idx_l0_default_active_minus1;
+  // H265PredWeightTable pred_weight_table;
+  h265slice.five_minus_max_num_merge_cand = 0;
+  h265slice.slice_qp_delta = 0;
+  h265slice.slice_cb_qp_offset = 0;
+  h265slice.slice_cr_qp_offset = 0;
+  h265slice.slice_deblocking_filter_disabled_flag = 0;
+  h265slice.slice_beta_offset_div2 = pps.pps_beta_offset_div2;
+  h265slice.slice_tc_offset_div2 = pps.pps_tc_offset_div2;
+  h265slice.slice_loop_filter_across_slices_enabled_flag = 0;
+
+  VAEncSequenceParameterBufferHEVC seq_param = {};
+  seq_param.general_profile_idc = sps.profile_tier_level.general_profile_idc;
+  seq_param.general_level_idc = sps.profile_tier_level.general_level_idc;
+  seq_param.general_tier_flag = 0;
+  seq_param.intra_period = kIPeriod > 0 ? kIPeriod : kIDRPeriod;
+  seq_param.intra_idr_period = kIDRPeriod;
+  seq_param.ip_period = kIPPeriod;
+  seq_param.bits_per_second = bitrate_bps;
+  seq_param.pic_width_in_luma_samples = sps.pic_width_in_luma_samples;
+  seq_param.pic_height_in_luma_samples = sps.pic_height_in_luma_samples;
+#define SPS_TO_SP_FS(a) seq_param.seq_fields.bits.a = sps.a;
+  SPS_TO_SP_FS(chroma_format_idc);
+  SPS_TO_SP_FS(separate_colour_plane_flag);
+  SPS_TO_SP_FS(bit_depth_luma_minus8);
+  SPS_TO_SP_FS(bit_depth_chroma_minus8);
+  SPS_TO_SP_FS(scaling_list_enabled_flag);
+  SPS_TO_SP_FS(strong_intra_smoothing_enabled_flag);
+  SPS_TO_SP_FS(amp_enabled_flag);
+  SPS_TO_SP_FS(sample_adaptive_offset_enabled_flag);
+  SPS_TO_SP_FS(pcm_enabled_flag);
+  SPS_TO_SP_FS(pcm_loop_filter_disabled_flag);
+  SPS_TO_SP_FS(sps_temporal_mvp_enabled_flag);
+  //SPS_TO_SP_FS(low_delay_seq);
+  //SPS_TO_SP_FS(hierachical_flag);
+#undef SPS_TO_SP_FS
+#define SPS_TO_SP(a) seq_param.a = sps.a;
+  SPS_TO_SP(log2_min_luma_coding_block_size_minus3);
+  SPS_TO_SP(log2_diff_max_min_luma_coding_block_size);
+  seq_param.log2_min_transform_block_size_minus2 = sps.log2_min_luma_transform_block_size_minus2;
+  seq_param.log2_diff_max_min_transform_block_size = sps.log2_diff_max_min_luma_transform_block_size;
+  SPS_TO_SP(max_transform_hierarchy_depth_inter);
+  SPS_TO_SP(max_transform_hierarchy_depth_intra);
+  SPS_TO_SP(pcm_sample_bit_depth_luma_minus1);
+  SPS_TO_SP(pcm_sample_bit_depth_chroma_minus1);
+  SPS_TO_SP(log2_min_pcm_luma_coding_block_size_minus3);
+  seq_param.log2_max_pcm_luma_coding_block_size_minus3 = sps.log2_min_pcm_luma_coding_block_size_minus3 + sps.log2_diff_max_min_pcm_luma_coding_block_size;
+  //SPS_TO_SP(vui_parameters_present_flag);
+#undef SPS_TO_SP
+
+
+  VAEncPictureParameterBufferHEVC pic_param = {};
+  auto va_surface_id = pic->AsVaapiH265Picture()->va_surface_id();
+  pic_param.decoded_curr_pic.picture_id = va_surface_id;
+  pic_param.decoded_curr_pic.pic_order_cnt = pic->pic_order_cnt;
+  pic_param.decoded_curr_pic.flags = 0;
+  //reference_frames, see below
+  pic_param.coded_buf = job.coded_buffer_id();
+  pic_param.collocated_ref_pic_index = pps.num_ref_idx_l0_default_active_minus1;
+  pic_param.last_picture = 0; // don't know ??
+  pic_param.pic_init_qp = pps.init_qp_minus26 + 26;
+  pic_param.diff_cu_qp_delta_depth = pps.diff_cu_qp_delta_depth ;
+  pic_param.pps_cb_qp_offset = pps.pps_cb_qp_offset;
+  pic_param.pps_cr_qp_offset = pps.pps_cr_qp_offset;
+  pic_param.num_tile_columns_minus1 = pps.num_tile_columns_minus1;
+  pic_param.num_tile_rows_minus1 = pps.num_tile_rows_minus1;
+  for (int i = 0; i < pps.num_tile_columns_minus1; i++) {
+      pic_param.column_width_minus1[i] = pps.column_width_minus1[i];
+  }
+  for (int i = 0; i < pps.num_tile_rows_minus1; i++) {
+      pic_param.row_height_minus1[i] = pps.row_height_minus1[i];
+  }
+  pic_param.log2_parallel_merge_level_minus2 = pps.log2_parallel_merge_level_minus2;
+  pic_param.ctu_max_bitsize_allowed = 0;
+  pic_param.num_ref_idx_l0_default_active_minus1 = pps.num_ref_idx_l0_default_active_minus1;
+  pic_param.num_ref_idx_l1_default_active_minus1 = pps.num_ref_idx_l1_default_active_minus1;
+  pic_param.slice_pic_parameter_set_id = 0;
+  pic_param.nal_unit_type = h265slice.nal_unit_type;
+  pic_param.pic_fields.bits.idr_pic_flag = pic->idr ;
+  int coding_type ;
+  switch( h265slice.slice_type ) {
+    case H265SliceHeader::kSliceTypeI :
+      coding_type = 1 ;
+      break ;
+    case H265SliceHeader::kSliceTypeP :
+      coding_type = 2 ;
+      break ;
+    case H265SliceHeader::kSliceTypeB :
+      coding_type = 3 ;
+      break ;
+  }
+  pic_param.pic_fields.bits.coding_type = coding_type ;
+  pic_param.pic_fields.bits.reference_pic_flag = (h265slice.slice_type != H265SliceHeader::kSliceTypeB);
+#define PPS_TO_PP_PF(a) pic_param.pic_fields.bits.a = pps.a;
+  PPS_TO_PP_PF(dependent_slice_segments_enabled_flag) ;
+  PPS_TO_PP_PF(sign_data_hiding_enabled_flag) ;
+  PPS_TO_PP_PF(constrained_intra_pred_flag) ;
+  PPS_TO_PP_PF(transform_skip_enabled_flag) ;
+  PPS_TO_PP_PF(cu_qp_delta_enabled_flag) ;
+  PPS_TO_PP_PF(weighted_pred_flag) ;
+  PPS_TO_PP_PF(weighted_bipred_flag) ;
+  PPS_TO_PP_PF(transquant_bypass_enabled_flag) ;
+  PPS_TO_PP_PF(tiles_enabled_flag) ;
+  PPS_TO_PP_PF(entropy_coding_sync_enabled_flag) ;
+  PPS_TO_PP_PF(loop_filter_across_tiles_enabled_flag) ;
+  PPS_TO_PP_PF(pps_loop_filter_across_slices_enabled_flag) ;
+  pic_param.pic_fields.bits.scaling_list_data_present_flag = pps.pps_scaling_list_data_present_flag ;
+  //PPS_TO_PP_PF(screen_content_flag) ;
+  //PPS_TO_PP_PF(enable_gpu_weighted_prediction) ;
+  //PPS_TO_PP_PF(no_output_of_prior_pics_flag) ;
+#undef PPS_TO_PP_PF
+
+  int lcu_size = 1 << (block_sizes_.log2_max_coding_tree_block_size_minus3 + 3);
+  int picture_height_in_ctus = (visible_size_.height() + lcu_size - 1) / lcu_size;
+  int picture_width_in_ctus = (visible_size_.width() + lcu_size - 1) / lcu_size;
+
+  VAEncSliceParameterBufferHEVC slice_param = {};
+  slice_param.slice_segment_address = h265slice.slice_segment_address ;
+  slice_param.num_ctu_in_slice = picture_width_in_ctus * picture_height_in_ctus ;
+  slice_param.slice_type = h265slice.slice_type;
+  slice_param.slice_pic_parameter_set_id = h265slice.slice_pic_parameter_set_id; // right???
+    slice_param.num_ref_idx_l0_active_minus1 = h265slice.num_ref_idx_l0_active_minus1;
+    slice_param.num_ref_idx_l1_active_minus1 = h265slice.num_ref_idx_l1_active_minus1;
+
+    slice_param.luma_log2_weight_denom = 0;
+    slice_param.delta_chroma_log2_weight_denom = 0;
+
+    slice_param.max_num_merge_cand = 5 - h265slice.five_minus_max_num_merge_cand;
+
+    slice_param.slice_qp_delta = h265slice.slice_qp_delta;
+    slice_param.slice_cb_qp_offset = 0;
+    slice_param.slice_cr_qp_offset = 0;
+    slice_param.slice_beta_offset_div2 = h265slice.slice_beta_offset_div2;
+    slice_param.slice_tc_offset_div2 = h265slice.slice_tc_offset_div2;
+
+    slice_param.slice_fields.bits.dependent_slice_segment_flag = 0;
+    slice_param.slice_fields.bits.colour_plane_id = h265slice.colour_plane_id;
+    slice_param.slice_fields.bits.slice_temporal_mvp_enabled_flag = h265slice.slice_temporal_mvp_enabled_flag;
+    slice_param.slice_fields.bits.slice_sao_luma_flag = h265slice.slice_sao_luma_flag;
+    slice_param.slice_fields.bits.slice_sao_chroma_flag = h265slice.slice_sao_luma_flag;
+    slice_param.slice_fields.bits.num_ref_idx_active_override_flag = h265slice.num_ref_idx_active_override_flag;
+    slice_param.slice_fields.bits.mvd_l1_zero_flag = 0;
+    slice_param.slice_fields.bits.cabac_init_flag = 0;
+    slice_param.slice_fields.bits.slice_deblocking_filter_disabled_flag = h265slice.slice_deblocking_filter_disabled_flag;
+    slice_param.slice_fields.bits.slice_loop_filter_across_slices_enabled_flag = h265slice.slice_loop_filter_across_slices_enabled_flag;
+    slice_param.slice_fields.bits.collocated_from_l0_flag = h265slice.collocated_from_l0_flag;
+
+  for (VAPictureHEVC& picture : pic_param.reference_frames)
+    InitVAPictureHEVC(&picture);
+
+  for (VAPictureHEVC& picture : slice_param.ref_pic_list0)
+    InitVAPictureHEVC(&picture);
+
+  for (VAPictureHEVC& picture : slice_param.ref_pic_list1)
+    InitVAPictureHEVC(&picture);
+
+  for (size_t i = 0, j = 0; i < ref_pic_list0.size(); ++i) {
+    H265Picture& ref_pic = *ref_pic_list0[i];
+    VAPictureHEVC va_pic_hevc;
+    InitVAPictureHEVC(&va_pic_hevc);
+    va_pic_hevc.picture_id = ref_pic.AsVaapiH265Picture()->va_surface_id();
+    va_pic_hevc.flags = 0;
+    va_pic_hevc.pic_order_cnt = ref_pic.pic_order_cnt;
+    // Initialize the current entry on slice and picture reference lists to
+    // |ref_pic| and advance list pointers.
+    pic_param.reference_frames[i] = va_pic_hevc;
+    slice_param.ref_pic_list0[j++] = va_pic_hevc;
+  }
+
+
+  std::vector<VaapiWrapper::VABufferDescriptor> va_buffers = {
+      {VAEncSequenceParameterBufferType, sizeof(seq_param), &seq_param},
+      {VAEncPictureParameterBufferType, sizeof(pic_param), &pic_param},
+      {VAEncSliceParameterBufferType, sizeof(slice_param), &slice_param}};
+
+  std::vector<uint8_t> misc_buffers[3];
+  if( submit_rates_ ) {
+    uint32_t target_percentage = 100u;
+    int qvbr_quality_factor = kDefaultQP ;
+    if (bitrate.mode() == Bitrate::Mode::kVariable) {
+      // In VA-API, the sequence parameter's bits_per_second represents the
+      // maximum bitrate. Above, we use the target_bps for |bitrate_bps|; this is
+      // because 1) for constant bitrates, peak and target are equal, and 2)
+      // |Bitrate| class does not store a peak_bps for constant bitrates. Here,
+      // we use the peak, because it exists for variable bitrates.
+      bitrate_bps = bitrate.peak_bps();
+      DCHECK_NE(bitrate.peak_bps(), 0u);
+      base::CheckedNumeric<uint32_t> checked_percentage =
+          base::CheckDiv(base::CheckMul<uint32_t>(bitrate.target_bps(), 100u),
+                        bitrate.peak_bps());
+      if (!checked_percentage.AssignIfValid(&target_percentage)) {
+        DVLOGF(1)
+            << "Integer overflow while computing target percentage for bitrate.";
+        return false;
+      }
+      target_percentage = checked_percentage.ValueOrDefault(100u);
+
+      int QVBRminus = (kMaxQVRBQuality - kMinQVRBQuality) * bitrate.target_bps() / kMaxQVBRBitrate ;
+      qvbr_quality_factor = kMaxQVRBQuality - QVBRminus ;
+      if( qvbr_quality_factor < kMinQVRBQuality ) {
+        qvbr_quality_factor = kMinQVRBQuality ;
+      }
+    }
+
+    CreateVAEncRateControlParams(
+        bitrate_bps, target_percentage, encode_params.cpb_window_size_ms, qvbr_quality_factor,
+        base::strict_cast<uint32_t>(pic_param.pic_init_qp),
+        base::strict_cast<uint32_t>(encode_params.min_qp),
+        base::strict_cast<uint32_t>(encode_params.max_qp),
+        encode_params.framerate,
+        base::strict_cast<uint32_t>(encode_params.cpb_size_bits), misc_buffers);
+
+    va_buffers.push_back({VAEncMiscParameterBufferType, misc_buffers[0].size(),
+       misc_buffers[0].data()});
+    va_buffers.push_back({VAEncMiscParameterBufferType, misc_buffers[1].size(),
+       misc_buffers[1].data()});
+    va_buffers.push_back({VAEncMiscParameterBufferType, misc_buffers[2].size(),
+       misc_buffers[2].data()});
+
+    submit_rates_ = false ;
+  }
+
+  scoped_refptr<H265BitstreamBuffer> packed_slice_header;
+  VAEncPackedHeaderParameterBuffer packed_slice_param_buffer;
+  if (submit_packed_headers_) {
+    packed_slice_header =
+        GeneratePackedSliceHeader(sps, pps, h265slice);
+    packed_slice_param_buffer.type = VAEncPackedHeaderSlice;
+    packed_slice_param_buffer.bit_length = packed_slice_header->BitsInBuffer();
+    packed_slice_param_buffer.has_emulation_bytes = 0;
+    va_buffers.push_back({VAEncPackedHeaderParameterBufferType,
+                          sizeof(packed_slice_param_buffer),
+                          &packed_slice_param_buffer});
+    va_buffers.push_back({VAEncPackedHeaderDataBufferType,
+                          packed_slice_header->BytesInBuffer(),
+                          packed_slice_header->data()});
+  }
+
+  return vaapi_wrapper_->SubmitBuffers(va_buffers);
+}
+
+bool H265VaapiVideoEncoderDelegate::SubmitPackedHeaders(
+    const H265BitstreamBuffer& packed_vps,
+    const H265BitstreamBuffer& packed_sps,
+    const H265BitstreamBuffer& packed_pps) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(submit_packed_headers_);
+
+
+  // Submit SPS.
+  VAEncPackedHeaderParameterBuffer packed_vps_param = {};
+  packed_vps_param.type = VAEncPackedHeaderHEVC_VPS;
+  packed_vps_param.bit_length = packed_vps.BytesInBuffer() * CHAR_BIT;
+  VAEncPackedHeaderParameterBuffer packed_sps_param = {};
+  packed_sps_param.type = VAEncPackedHeaderHEVC_SPS;
+  packed_sps_param.bit_length = packed_sps.BytesInBuffer() * CHAR_BIT;
+  VAEncPackedHeaderParameterBuffer packed_pps_param = {};
+  packed_pps_param.type = VAEncPackedHeaderHEVC_PPS;
+  packed_pps_param.bit_length = packed_pps.BytesInBuffer() * CHAR_BIT;
+
+  return vaapi_wrapper_->SubmitBuffers(
+      {{VAEncPackedHeaderParameterBufferType, sizeof(packed_vps_param),
+        &packed_vps_param},
+       {VAEncPackedHeaderDataBufferType, packed_vps.BytesInBuffer(),
+        packed_vps.data()},
+       {VAEncPackedHeaderParameterBufferType, sizeof(packed_sps_param),
+        &packed_sps_param},
+       {VAEncPackedHeaderDataBufferType, packed_sps.BytesInBuffer(),
+        packed_sps.data()},
+       {VAEncPackedHeaderParameterBufferType, sizeof(packed_pps_param),
+        &packed_pps_param},
+       {VAEncPackedHeaderDataBufferType, packed_pps.BytesInBuffer(),
+        packed_pps.data()}});
+}
